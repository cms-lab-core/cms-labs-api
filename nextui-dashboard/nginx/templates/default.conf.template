map $http_x_forwarded_proto $forwarded_proto {
    "~*^https$" https;
    default    $scheme;
}

# Successful workspace authorization is identical for every resource request
# made with the same signed cookie inside one session. Keep it briefly in nginx
# so JupyterLab's parallel asset/API requests do not hit Clabgate one by one.
# The session id is part of the key to prevent a valid cookie from being reused
# for another workspace. Only HTTP 204 is cached; authorization failures always
# reach Clabgate again.
map $request_uri $workspace_auth_session_id {
    "~^/clabgate/workspace/(?<workspace_auth_session>[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?:/|$)" $workspace_auth_session;
    default "";
}

proxy_cache_path /var/cache/nginx/workspace-auth
    keys_zone=workspace_auth:1m
    max_size=16m
    inactive=10m
    use_temp_path=off;

server {
    index index.html;
    error_log  /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;
    resolver ${SYSTEM_DNS} valid=1s ipv6=off;

    gzip on;
    gzip_http_version 1.1;
    gzip_disable      "MSIE [1-6]\.";
    gzip_min_length   1100;
    gzip_vary         on;
    gzip_proxied      expired no-cache no-store private auth;
    gzip_types        text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_comp_level   9;

    root /usr/share/nginx/html/;

    ${SSL_CONF}
    listen 80 default;

    # Production serves the bundled application here. The local kind gateway
    # mounts a development version of this include which proxies Vite instead.
    include /etc/nginx/frontend-location.conf;

    # Проксирование /api/ на другой контейнер
    location /api/ {
        set $target_host ${CMS_CORE_SERVICE};
        proxy_pass $target_host;
        proxy_set_header Host              $host;
        proxy_set_header X-Scheme          $scheme;
        proxy_set_header X-Original-URI    $request_uri;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Internal authorization subrequest for both HTTP and WebSocket workspace traffic.
    location = /_clabgate_workspace_verify {
        internal;
        set $target_host ${CLABGATE_SERVICE};
        proxy_pass $target_host/clabgate/workspace-auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Cookie $http_cookie;
        proxy_cache workspace_auth;
        proxy_cache_key "$cookie_clabgate_workspace:$workspace_auth_session_id";
        proxy_cache_valid 204 5m;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 5s;
        proxy_cache_lock_age 5s;
    }

    # Exchanges a short-lived grant for a scoped HttpOnly workspace cookie.
    location /clabgate/workspace-auth/ {
        set $target_host ${CLABGATE_SERVICE};
        proxy_pass $target_host;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Per-attempt terminal Service supplied by the task manifest and applied by Clabgate. It shares
    # the session-scoped HttpOnly cookie with Jupyter but resolves only inside that namespace.
    location ~ "^/clabgate/workspace/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/terminal/([a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)(/.*)?$" {
        set $terminal_session $1;
        set $terminal_service $2;
        set $terminal_path $3;
        set $terminal_target http://$terminal_service.lab-$terminal_session.svc.cluster.local:7681;

        auth_request /_clabgate_workspace_verify;
        # ttyd currently rejects auth-header values of 30 bytes or more. Clabgate returns a
        # separate compact identity for ttyd while X-CMS-Identity remains the full Jupyter identity.
        auth_request_set $terminal_identity $upstream_http_x_cms_terminal_identity;

        proxy_pass $terminal_target$terminal_path;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_connect_timeout               1800s;
        proxy_send_timeout                  1800s;
        proxy_read_timeout                  1800s;
        proxy_buffering                     off;
        proxy_cache                         off;
        # Preserve the browser-visible port for ttyd WebSocket origin checks.
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Original-URI    $request_uri;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # ttyd's auth-proxy mode requires this header. Always overwrite a browser-supplied value
        # with the identity returned by Clabgate's internal authorization subrequest.
        proxy_set_header X-CMS-Identity $terminal_identity;
    }

    # Per-attempt packet-capture API. The controller creates this Service only
    # for labs declaring cms-labs-capture-config. The external prefix is removed
    # before forwarding, so /capture/v1/targets becomes /v1/targets.
    location ~ "^/clabgate/workspace/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/capture(/.*)?$" {
        set $capture_session $1;
        set $capture_path $2;
        set $capture_target http://cms-labs-capture.lab-$capture_session.svc.cluster.local:8080;

        auth_request /_clabgate_workspace_verify;
        auth_request_set $capture_identity $upstream_http_x_cms_identity;

        proxy_pass $capture_target$capture_path$is_args$args;
        proxy_http_version 1.1;
        proxy_connect_timeout              30s;
        proxy_send_timeout                 90s;
        proxy_read_timeout                 90s;
        client_max_body_size               64k;
        proxy_request_buffering            off;
        proxy_buffering                    off;
        proxy_cache                        off;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Original-URI    $request_uri;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-CMS-Identity    $capture_identity;
    }

    # Per-attempt JupyterLab. Every request is authorized before nginx resolves
    # and contacts the namespace-local Service.
    location ~ "^/clabgate/workspace/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(/.*)?$" {
        set $workspace_session $1;
        set $workspace_target http://jupyter.lab-$workspace_session.svc.cluster.local:8888;

        auth_request /_clabgate_workspace_verify;
        auth_request_set $workspace_identity $upstream_http_x_cms_identity;

        proxy_pass $workspace_target$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_connect_timeout               1800s;
        proxy_send_timeout                  1800s;
        proxy_read_timeout                  1800s;
        proxy_buffering                     off;
        proxy_cache                         off;

        # Jupyter/Tornado compares Host with Origin for state-changing
        # requests and WebSocket upgrades, so the external port is required.
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Scheme          $scheme;
        proxy_set_header X-Original-URI    $request_uri;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # Always overwrite the browser-supplied value with the identity returned
        # by Clabgate's internal authorization subrequest.
        proxy_set_header X-CMS-Identity $workspace_identity;
    }

    # Проксирование /clabgate/api/ на другой контейнер (общий fallback)
    location /clabgate/api/ {
        set $target_host ${CLABGATE_SERVICE};
        proxy_pass $target_host;
        proxy_set_header Host              $host;
        proxy_set_header X-Scheme          $scheme;
        proxy_set_header X-Original-URI    $request_uri;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
}
