# Stage status to start server:
#   - "dev", for start server without graceful shutdown
#   - "prod", for start server with graceful shutdown
STAGE_STATUS="prod"
DEBUG="false"

# Server settings:
SERVER_HOST="0.0.0.0"
SERVER_PORT=5001
SERVER_READ_TIMEOUT=60
CMS_URL=http://localhost:5000
CMS_LOGIN=demo-kubernetes
CMS_PASSWORD=demo-secret
CMS_TASK_URL=https://github.com/cms-lab-core/cms-labs-simple-task
CMS_TASK_BRANCH=main
JUPYTER_IMAGE=ghcr.io/cms-lab-core/cms-labs-jupyter:latest
JUPYTER_STORAGE_SIZE=1Gi
WORKSPACE_AUTH_SECRET=cms-labs-demo-cookie-secret-change-before-production
WORKSPACE_COOKIE_SECURE=false
CHECKER_IMAGE=ghcr.io/cms-lab-core/cms-labs-checker:latest
SESSION_RECONCILE_INTERVAL_SECONDS=3
